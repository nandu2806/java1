 class salary
{
     public static void main(String[] args)
     {
         Programmer pg=new Programmer();
         AssistantProfessor asp=new AssistantProfessor();
         AssociateProfessor aop=new AssociateProfessor();
         Professor pf=new Professor();
         Scanner in=new Scanner(System.in);
         System.out.println("Enter Designation");
         String ch=in.nextLine();
         switch(ch)
         {
            case "Programmer":
                 pg.input();
                 if (pg.bp>=15000&&pg.bp<=20000)
                 {
                     pg.progsal();
                     pg.output();
                 }
                 else
                     System.out.println("Invalid Salary");
                 break;
            case "AssistantProfessor":
                 asp.input();
                 if (asp.bp>20000&&asp.bp<=30000)
                 {
                     asp.Astprofsal();
                     asp.output();
                 }
                 else
                     System.out.println("Invalid Salary");
                 break;
            case "AssociateProfessor":
                 aop.input();
                 if (aop.bp>30000&&aop.bp<=40000)
                 {
                     aop.Asteprofsal();
                     aop.output();
                 }
                 else
                     System.out.println("Invalid Salary");
                 break;
            case "Professor":
                 pf.input();
                 if (pf.bp>30000&pf.bp<=40000)
                     {
                     pf.profsal();
                     pf.output();
                 }
                 else
                     System.out.println("Invalid Salary");
                 break;
            default:
                System.out.println("Invalid input");
                break;
         }
     }
 }

